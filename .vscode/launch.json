{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Backend",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"],
      "restart": true,
      "sourceMaps": true
    },
    {
      "name": "Launch Backend with Inspect",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run backend:inspect",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Backend (Direct)",
      "type": "node-terminal",
      "request": "launch",
      "command": "node --inspect api/server/index.js",
      "env": {
        "NODE_ENV": "production"
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}
